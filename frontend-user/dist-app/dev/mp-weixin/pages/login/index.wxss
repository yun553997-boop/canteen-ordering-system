.login-container.data-v-45258083 {
  position: relative;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 60rpx 40rpx;
}
.corner-badge.data-v-45258083 {
  position: absolute;
  top: 40rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  border: 2rpx solid #FF6B35;
  border-radius: 32rpx;
}
.login-header.data-v-45258083 {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.logo.data-v-45258083 {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}
.app-name.data-v-45258083 {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 登录/注册切换 */
.role-tabs.data-v-45258083 {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}
.role-tab.data-v-45258083 {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #999;
  transition: all 0.3s;
}
.role-tab.active.data-v-45258083 {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

/* 表单 */
.form-box.data-v-45258083 {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}
.input-group.data-v-45258083 {
  margin-bottom: 30rpx;
}
.input-label.data-v-45258083 {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}
.input-field.data-v-45258083 {
  width: 100%;
  height: 80rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.phone-row.data-v-45258083 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.phone-prefix.data-v-45258083 {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.code-row.data-v-45258083 {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.code-input.data-v-45258083 {
  flex: 1;
}
.code-btn.data-v-45258083 {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  background: #FF6B35;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 0;
}
.code-btn[disabled].data-v-45258083 {
  background: #ccc;
  color: #999;
}
.forgot-row.data-v-45258083 {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}
.forgot-link.data-v-45258083 {
  font-size: 26rpx;
  color: #FF6B35;
}
.submit-btn.data-v-45258083 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

/* 协议勾选 */
.agreement-box.data-v-45258083 {
  margin-top: 40rpx;
}
.agreement-row.data-v-45258083 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}
.checkbox.data-v-45258083 {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.checkbox.checked.data-v-45258083 {
  background: #FF6B35;
  border-color: #FF6B35;
}
.check-icon.data-v-45258083 {
  color: #fff;
  font-size: 20rpx;
}
.agreement-label.data-v-45258083 {
  color: #999;
}
.agreement-link.data-v-45258083 {
  color: #FF6B35;
}
.shake.data-v-45258083 {
  animation: shake-45258083 0.4s;
}
@keyframes shake-45258083 {
0%, 100% { transform: translateX(0);
}
20% { transform: translateX(-12rpx);
}
40% { transform: translateX(12rpx);
}
60% { transform: translateX(-12rpx);
}
80% { transform: translateX(12rpx);
}
}

/* 弹窗 */
.modal-mask.data-v-45258083 {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-box.data-v-45258083 {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 600rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.modal-title.data-v-45258083 {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-content.data-v-45258083 {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  overflow-y: auto;
}
.forgot-field.data-v-45258083 {
  margin-bottom: 24rpx;
}
.modal-close.data-v-45258083 {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  border: none;
  border-radius: 12rpx;
}
.modal-cancel.data-v-45258083 {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 16rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border: none;
  border-radius: 12rpx;
}