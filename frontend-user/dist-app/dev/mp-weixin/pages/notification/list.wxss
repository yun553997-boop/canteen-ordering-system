.notif-container.data-v-f50c1698 {
  min-height: 100vh;
  background: #f5f5f5;
}
.notif-toolbar.data-v-f50c1698 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.toolbar-title.data-v-f50c1698 {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.toolbar-action.data-v-f50c1698 {
  font-size: 26rpx;
  color: #FF6B35;
}
.notif-list.data-v-f50c1698 {
  padding-top: 0;
}
.notif-item.data-v-f50c1698 {
  display: flex;
  align-items: flex-start;
  background: #fff;
  padding: 24rpx 30rpx;
  gap: 16rpx;
}
.notif-item.unread.data-v-f50c1698 {
  background: #FFF9F5;
}
.notif-left.data-v-f50c1698 {
  padding-top: 6rpx;
}
.unread-dot.data-v-f50c1698 {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF3B30;
}
.read-dot.data-v-f50c1698 {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
}
.notif-body.data-v-f50c1698 {
  flex: 1;
}
.notif-top.data-v-f50c1698 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.notif-title.data-v-f50c1698 {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.notif-time.data-v-f50c1698 {
  font-size: 22rpx;
  color: #ccc;
}
.notif-content.data-v-f50c1698 {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 空态 */
.empty-tip.data-v-f50c1698 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon.data-v-f50c1698 {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text.data-v-f50c1698 {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more.data-v-f50c1698 {
  text-align: center;
  padding: 24rpx;
}
.load-text.data-v-f50c1698 {
  font-size: 26rpx;
  color: #999;
}