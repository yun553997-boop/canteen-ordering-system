.mine-container.data-v-d41d38da {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部信息区 */
.profile-header.data-v-d41d38da {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  padding: 40rpx 30rpx;
  padding-top: calc(40rpx + var(--status-bar-height, 0px));
}
.header-left.data-v-d41d38da {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-text.data-v-d41d38da {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-letter.data-v-d41d38da {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.user-info.data-v-d41d38da {
  display: flex;
  flex-direction: column;
}
.name-row.data-v-d41d38da {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.role-tag.data-v-d41d38da {
  font-size: 20rpx;
  background: rgba(255,255,255,0.3);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.username.data-v-d41d38da {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}
.phone.data-v-d41d38da {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}
.header-right.data-v-d41d38da {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.icon-btn.data-v-d41d38da {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}
.icon-text.data-v-d41d38da {
  font-size: 40rpx;
}
.badge.data-v-d41d38da {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #FF3B30;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}
.badge-text.data-v-d41d38da {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}

/* 功能入口 */
.func-area.data-v-d41d38da {
  padding: 40rpx 30rpx 0;
}
.func-card.data-v-d41d38da {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.func-item.data-v-d41d38da {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.func-icon.data-v-d41d38da {
  font-size: 52rpx;
}
.func-label.data-v-d41d38da {
  font-size: 26rpx;
  color: #666;
}

/* 退出登录 */
.logout-area.data-v-d41d38da {
  padding: 40rpx 30rpx;
}
.logout-btn.data-v-d41d38da {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #FF3B30;
  font-size: 30rpx;
  border: 2rpx solid #FF3B30;
  border-radius: 12rpx;
}
.login-btn.data-v-d41d38da {
  background: #FF6B35;
  color: #fff;
  border-color: #FF6B35;
}