<view class="order-container data-v-5511cfa9"><view class="status-card data-v-5511cfa9"><view class="status-icon data-v-5511cfa9"><text wx:if="{{a}}" class="icon-text data-v-5511cfa9">⏳</text><text wx:elif="{{b}}" class="icon-text data-v-5511cfa9">👨‍🍳</text><text wx:elif="{{c}}" class="icon-text data-v-5511cfa9">✅</text><text wx:elif="{{d}}" class="icon-text data-v-5511cfa9">📦</text><text wx:else class="icon-text data-v-5511cfa9">📋</text></view><text class="status-title data-v-5511cfa9">{{e}}</text><text class="status-desc data-v-5511cfa9">{{f}}</text></view><view class="progress-bar data-v-5511cfa9"><view wx:for="{{g}}" wx:for-item="step" wx:key="f" class="{{['step-item', 'data-v-5511cfa9', step.g && 'done', step.h && 'current']}}"><view class="step-dot data-v-5511cfa9"><text wx:if="{{step.a}}" class="dot-check data-v-5511cfa9">✓</text><text wx:else class="dot-num data-v-5511cfa9">{{step.b}}</text></view><text class="step-label data-v-5511cfa9">{{step.c}}</text><view wx:if="{{step.d}}" class="{{['step-line', 'data-v-5511cfa9', step.e && 'filled']}}"/></view></view><view wx:if="{{h}}" class="pickup-card data-v-5511cfa9"><text class="pickup-label data-v-5511cfa9">取餐码</text><image wx:if="{{i}}" class="pickup-qr data-v-5511cfa9" src="{{j}}" mode="aspectFit"/><text class="pickup-code data-v-5511cfa9">{{k}}</text><text class="pickup-tip data-v-5511cfa9">请在取餐窗口出示此码</text></view><view class="section data-v-5511cfa9"><text class="section-title data-v-5511cfa9">菜品清单</text><view wx:for="{{l}}" wx:for-item="item" wx:key="d" class="order-item data-v-5511cfa9"><view class="item-img-placeholder data-v-5511cfa9">🍽️</view><view class="item-info data-v-5511cfa9"><text class="item-name data-v-5511cfa9">{{item.a}}</text></view><view class="item-right data-v-5511cfa9"><text class="item-count data-v-5511cfa9">×{{item.b}}</text><text class="item-price data-v-5511cfa9">¥{{item.c}}</text></view></view></view><view class="section data-v-5511cfa9"><text class="section-title data-v-5511cfa9">金额明细</text><view class="price-row total data-v-5511cfa9"><text class="price-label data-v-5511cfa9">实付金额</text><text class="price-value total-price data-v-5511cfa9">¥{{m}}</text></view></view><view class="section data-v-5511cfa9"><text class="section-title data-v-5511cfa9">订单信息</text><view class="info-row data-v-5511cfa9"><text class="info-label data-v-5511cfa9">订单编号</text><text class="info-value data-v-5511cfa9">{{n}}</text></view><view class="info-row data-v-5511cfa9"><text class="info-label data-v-5511cfa9">下单时间</text><text class="info-value data-v-5511cfa9">{{o}}</text></view><view class="info-row data-v-5511cfa9"><text class="info-label data-v-5511cfa9">餐次</text><text class="info-value data-v-5511cfa9">{{p}}</text></view></view><view wx:if="{{q}}" class="cancel-section data-v-5511cfa9"><button class="cancel-btn data-v-5511cfa9" bindtap="{{r}}">取消订单</button></view></view>