.menu-container.data-v-83a5a03c {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 餐次切换 */
.meal-tabs.data-v-83a5a03c {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
}
.meal-tab.data-v-83a5a03c {
  padding: 16rpx 44rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}
.meal-tab.active.data-v-83a5a03c {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

/* 菜品列表 */
.dish-list.data-v-83a5a03c {
  flex: 1;
  padding: 20rpx;
}
.dish-card.data-v-83a5a03c {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  padding: 20rpx;
}
.dish-img.data-v-83a5a03c {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.dish-info.data-v-83a5a03c {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.dish-name.data-v-83a5a03c {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.dish-desc.data-v-83a5a03c {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-meta.data-v-83a5a03c {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dish-price.data-v-83a5a03c {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
}
.price-symbol.data-v-83a5a03c {
  font-size: 24rpx;
}
.dish-stock.data-v-83a5a03c {
  font-size: 22rpx;
  color: #999;
}
.dish-bottom.data-v-83a5a03c {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.sold-out.data-v-83a5a03c {
  font-size: 24rpx;
  color: #ccc;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.cart-control.data-v-83a5a03c {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ctrl-btn.data-v-83a5a03c {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 48rpx;
  padding: 0;
  border: none;
}
.ctrl-btn.add.data-v-83a5a03c {
  background: #FF6B35;
  color: #fff;
}
.ctrl-btn.add[disabled].data-v-83a5a03c {
  background: #ccc;
}
.ctrl-btn.minus.data-v-83a5a03c {
  background: #eee;
  color: #333;
}
.cart-num.data-v-83a5a03c {
  font-size: 28rpx;
  font-weight: bold;
  min-width: 40rpx;
  text-align: center;
}
.empty-tip.data-v-83a5a03c {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* 底部购物车栏 */
.cart-bar.data-v-83a5a03c {
  position: fixed;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.cart-info.data-v-83a5a03c {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cart-icon-wrap.data-v-83a5a03c {
  position: relative;
}
.cart-icon.data-v-83a5a03c {
  font-size: 44rpx;
}
.cart-badge.data-v-83a5a03c {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 32rpx;
}
.cart-total.data-v-83a5a03c {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B35;
}
.checkout-btn.data-v-83a5a03c {
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  border-radius: 36rpx;
  padding: 16rpx 40rpx;
}

/* 支付确认面板 */
.pay-mask.data-v-83a5a03c {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.pay-sheet.data-v-83a5a03c {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.pay-title.data-v-83a5a03c {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}
.pay-row.data-v-83a5a03c {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.pay-label.data-v-83a5a03c {
  font-size: 28rpx;
  color: #666;
}
.pay-amount.data-v-83a5a03c {
  font-size: 34rpx;
  font-weight: bold;
  color: #FF6B35;
}
.pay-balance.data-v-83a5a03c {
  font-size: 30rpx;
  color: #333;
}
.pay-btn.data-v-83a5a03c {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
  font-size: 30rpx;
  border: none;
  border-radius: 12rpx;
}
.pay-btn.confirm.data-v-83a5a03c {
  background: #67C23A;
  color: #fff;
}
.pay-btn.insufficient.data-v-83a5a03c {
  background: #ccc;
  color: #fff;
}